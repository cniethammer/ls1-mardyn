option(ENABLE_ADIOS2 "Enables the ADIOS2 writer type." ON)

if (ENABLE_ADIOS2)
    find_package(ADIOS2 REQUIRED)

    if(NOT DEFINED ADIOS2_HAVE_MPI)
        set(ADIOS2_HAVE_MPI OFF)
    endif()
    if(ADIOS2_HAVE_MPI AND NOT ENABLE_MPI)
        message(WARNING "ADIOS2 was built with MPI but ENABLE_MPI is OFF. Either enable MPI (-DENABLE_MPI=ON) or use an ADIOS2 build without MPI.")
    elseif(ENABLE_MPI AND NOT ADIOS2_HAVE_MPI)
        message(FATAL_ERROR "ENABLE_MPI is ON but ADIOS2 was built without MPI")
    endif()
    message(STATUS "Using ADIOS2.")
else ()
    message(STATUS "Not using ADIOS2.")
endif ()
